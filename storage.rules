rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // option-images/{uid}/{fileName} - images uploaded for poll options at
    // creation time (see public/views/create.js). Readable by anyone
    // signed in, matching how polls/{pollId} itself is readable in
    // firestore.rules (anonymous sign-in is free, so this is effectively
    // public - poll content has to be visible to voters). Only the
    // uploader's own uid can write or delete under their own prefix.
    match /option-images/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
